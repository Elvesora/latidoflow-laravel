{
    "name": "latidoflow/laravel",
    "description": "Heartbeat monitoring for Laravel scheduler and queue workloads with LatidoFlow.",
    "keywords": [
        "heartbeat",
        "laravel",
        "monitoring",
        "queue",
        "scheduler"
    ],
    "homepage": "https://www.latidoflow.com",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/Elvesora/latidoflow-laravel/issues",
        "source": "https://github.com/Elvesora/latidoflow-laravel"
    },
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.21",
        "mockery/mockery": "^1.6.12",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5.50|^12.5.8"
    },
    "autoload": {
        "psr-4": {
            "LatidoFlow\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LatidoFlow\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:coverage": "@php vendor/bin/phpunit --coverage-text",
        "format": "@php vendor/bin/pint --format agent",
        "lint": "@php vendor/bin/pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "LatidoFlow\\Laravel\\LatidoFlowServiceProvider"
            ]
        }
    },
    "archive": {
        "exclude": [
            "/.github",
            "/tests",
            "/.editorconfig",
            "/.gitattributes",
            "/.gitignore",
            "/.idea",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/.vscode",
            "/.build",
            "/composer.lock",
            "/phpunit.xml.dist",
            "/vendor"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
